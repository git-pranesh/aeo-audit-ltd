rules_version = '2';

// Citation Rocket LTD: the browser never reads or writes Firestore.
// All data access goes through the API server (firebase-admin bypasses rules),
// which authenticates every request and is the only writer of licenses,
// entitlements, keys, branding and audits.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
