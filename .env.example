# ── Required ────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts customer OpenRouter keys (AES-256-GCM).
# Generate: openssl rand -base64 32   — keep it out of Firestore and git.
KEY_ENCRYPTION_SECRET=

# Firebase project (also used by the web client at build time).
VITE_FIREBASE_PROJECT_ID=ai-citation-51aba
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# Server credentials. On Cloud Run leave empty and grant the service account
# "Cloud Datastore User" + "Firebase Authentication Admin". Locally, paste the
# service-account JSON (single line).
FIREBASE_SERVICE_ACCOUNT=

# Comma-separated admin emails (must be verified in Firebase Auth).
ADMIN_EMAILS=support@citationrocket.com

# ── Direct sales (Dodo Payments, one-time products only) ───────────────────
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_LIFETIME=
DODO_PRODUCT_AGENCY=
# Developer → API keys. Used for checkout sessions (founding price steps) and self-serve refunds.
# Both products need "Pay What You Want" enabled with the base price as the minimum.
DODO_API_KEY=
# DODO_API_BASE=https://test.dodopayments.com   (test mode)

# ── Optional ────────────────────────────────────────────────────────────────
# Higher Jina Reader rate limits for JS-rendered sites (free tier works without).
JINA_API_KEY=
# Google Knowledge Graph lookups in the blueprint (free quota).
GOOGLE_KG_API_KEY=
# Override models (all calls go through the customer's OpenRouter key).
MODEL_STRUCTURED=deepseek/deepseek-v4-flash
MODEL_WEB_SEARCH=perplexity/sonar
PORT=5001
